<?xml version="1.0" encoding="utf-8"?>
<!--
   Pixel Heat keeps its thermal history (Room database) and settings (shared preferences) on the
   device only: they are excluded from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
