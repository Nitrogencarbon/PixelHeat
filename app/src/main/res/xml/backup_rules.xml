<?xml version="1.0" encoding="utf-8"?>
<!--
   Pixel Heat keeps its thermal history (Room database) and settings (shared preferences) on the
   device only: nothing is copied to cloud backup. Ignored on API 31+, see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
